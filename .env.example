# Copy this file to .env and fill in the values.  .env is gitignored - never commit it.

# CALL-E: https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# The phone number CALL-E should dial for the demo, E.164 format (e.g. +4915112345678)
DEMO_PHONE_NUMBER=

# AWS Bedrock region for the Strands agent (credentials come from `aws configure`,
# NOT from this file - see scripts/check_credentials.py)
AWS_REGION=eu-central-1

# Bedrock Projects ("mantle") OpenAI-compatible endpoint. This works on the AWS
# free account plan, where classic bedrock-runtime returns "Operation not allowed".
# Get the key from the Bedrock console -> Projects -> API keys.
AWS_BEARER_TOKEN_BEDROCK=
MANTLE_MODEL_ID=google.gemma-4-31b
